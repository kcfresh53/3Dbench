/*
id: blockmorphism
name: Blockmorphism
author: SirJain
version: 2.0.1
borders: true
*/
body {
	--color-ui: #1e242d;
	--color-back: #17191d;
	--color-dark: #0a0b0d;
	--color-border: #181a1f;
	--color-selected: #414a61;
	--color-button: #2d3546;
	--color-bright_ui: #353944;
	--color-accent: #566281;
	--color-frame: #181a1f;
	--color-text: #b6b6be;
	--color-light: #7a7a7a;
	--color-accent_text: #ffffff;
	--color-bright_ui_text: #bdbdbd;
	--color-subtle_text: #98999c;
	--color-grid: #454951;
	--color-wireframe: #576f82;
	--color-checkerboard: #121417;
}
@scope (thumbnail) {
div.theme_preview_sidebar {
	    border-radius: 0px 0px 10px 10px;
	}
	
	div.theme_preview_window {
	    border-radius: 0px 0px 10px 10px;
	}
	
	div.theme_preview_sidebar::after {
	    border-radius: 0px 0px 10px 10px;
	}
	
	div.theme_preview_header {
	    border-radius: 10px 10px 0px 0px;
	}
	
	div.theme_preview {
	    border-radius: 10px;
	}
	
	div.theme_preview_menu {
	    border-radius: 10px;
	}
	
	div.theme_preview_menu_header {
	    border-radius: 0px 0px 5px 5px;
	}
}
/*
Made by SirJain
Version 2.0.1
*/

#palette_list .color.contrast { 
    border-radius: 0px;
}

div.theme {
    border-radius: 10px;
}

.contextMenu li:hover {
    transition: border-radius .06s ease-in-out;
    border-radius: 5px;
}

div.select_option,
div.tool.widget.bar_select.icon_mode {
    border-radius: 5px;
}

content {
    border-radius: 20px;
}

div#backup-recent-tab.backup-tab,
div#backup-backup-tab.backup-tab,
li {
    border-radius: 10px;
}

.contextMenu {
    border-radius: 10px;
    backdrop-filter: blur(25px);
    background-color: rgba(54, 54, 70, 0.5);
    transition: background-color 0.2s;
    animation: context_menu 0.15s;
}

ul.recent_list_grid > li:hover,
li.backup-item:hover {
    transition: all 0.2s ease-out;
    transform: scale(0.98);
}

.contextMenu.sub {
    border-radius: 10px;
    backdrop-filter: blur(10px);
    background-color: rgba(40, 40, 50, 1);
    border: solid 2px rgba(27, 21, 23, 0.6);
}

li.menu_bar_point {
    border-radius: 0px 0px 5px 5px;
}

dialog {
    background-color: rgba(30, 36, 45, 0.6);
    backdrop-filter: blur(20px);
    border-radius: 20px;
}

a.open-in-browser {
    border-radius: 10px;
}

#plugin_list > li {
    border-radius: 10px;
    margin: 10px !important
}

label.toggle_panel {
    border-radius: 5px;
}

#plugin_list > li:hover {
    transition: all .1s ease-in-out;
    transform: scale(0.98);
}

div.project_tab {
    border-radius: 8px 8px 0px 0px
}

div.nslide.tab_target {
    border-radius: 5px;
}

bb-select {
    border-radius: 6px;
}

@keyframes context_menu {
    from { font-size: 15px }
    to { font-size: auto }
}
.contextMenu.sub {
    border-radius: 15px;
    backdrop-filter: blur(10px);
    background-color: rgba(40, 40, 50, 0.9);
    border: solid 2px rgba(27, 21, 23, 0.6);
}

dialog#theme.dialog.draggable.ui-draggable {
    border-radius: 12px;
}

div.dialog_handle.ui-draggable-handle {
    border-radius: 12px 12px 0px 0px;
}

div.dialog_sidebar {
    border-radius: 10px;
}

div.dialog_close_button {
    border-radius: 0px 10px 0px 0px;
}

.play_animation > i {
    color: auto;
}

.play_animation:hover {
    color: rgba(54, 228, 78);
}

button {
    border-radius: 7px;
}

button:hover {
    transition: all .1s ease-in-out;
    border-radius: 5px;
}

dialog .dialog_bar > input:is([type="text"], [type="password"]) {
    background-color:#212830;
    border-radius: 5px;
    padding: 6px, 6px, 6px, 6px;
}

.material-icons {
    transition: all 0.3s;
}

#plugin_list li {
    border-radius: 7px;
    transition: all 0.2s;
    backdrop-filter: blur(6px);
}

div.nslide.tab_target {
    border-radius: 5px;
}

.dropdown-content {
    border-radius: 14px;
    backdrop-filter: blur(10px);
    background-color: rgba(255, 255, 255, 0.2);
    border: solid 2px rgba(27, 21, 23, 0.3);
}

outliner {
    background-color: rgba(255, 255, 255);
}

#tab_bar .project_tab {
    border-radius: 7px 7px 0px 0px;
    border-top: 4px;
    padding-top: 2px;
    padding-bottom: 1px;
}

#tab_bar .project_tab:hover {
    background-color: rgba(255, 255, 255);
}

#tab_bar .project_tab.selected {
    background-color: rgba(82, 105, 130);
    border-top: 4px;
    padding-top: 2px;
} 

#tab_bar {
    height: 30px;
}

.project_tab_close_button {
    padding: 2px 0px 2px 0px;
    transition: all 0.4s;
}

#new_tab_button {
    height: 26px;
    width: 28px;
    margin: 1px 0px 1px 3px;
    padding: 3px;
    border-radius: 7px;
    background-color: transparent;
    transition: all .4s;
}  

#new_tab_button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}
